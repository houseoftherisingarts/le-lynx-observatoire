rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Aides
    // =====================================================================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(u) {
      return signedIn() && uid() == u;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    function str(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= maxLen;
    }

    function optStr(field, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maxLen);
    }

    function touchesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // =====================================================================
    // Comptes et profils
    // =====================================================================

    // Dossier prive du compte. Le role ne se change jamais depuis le navigateur.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Fiche publique, visible de tous les membres connectes.
    match /membres/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && str('nom', 120);
      // Le champ « verifie » appartient a l'administration, pas a la personne.
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['verifie']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /badges/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =====================================================================
    // Veille quotidienne
    // =====================================================================

    match /news/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /auditStatus/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /auditRuns/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Chronologie historique, tenue par l'administration.
    match /chronologie/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================================
    // Le Mur (place publique)
    // =====================================================================

    match /mur/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && optStr('texte', 4000)
        && request.resource.data.pour == 0
        && request.resource.data.contre == 0
        && request.resource.data.score == 0
        && request.resource.data.nbCommentaires == 0
        && request.resource.data.epingle == false;
      // Le compte des votes et des commentaires appartient au serveur.
      allow update: if isAdmin()
        || (isOwner(resource.data.uid) && touchesOnly(['texte', 'photoUrl', 'majLe']));
      allow delete: if isAdmin() || isOwner(resource.data.uid);

      match /votes/{voterId} {
        allow read: if true;
        allow create, update: if isOwner(voterId)
          && request.resource.data.valeur in [1, -1];
        allow delete: if isOwner(voterId) || isAdmin();
      }

      match /commentaires/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == uid()
          && str('texte', 2000);
        allow update: if isOwner(resource.data.uid) && touchesOnly(['texte', 'majLe']);
        allow delete: if isAdmin() || isOwner(resource.data.uid);
      }
    }

    // Requetes de groupe : « qu'est-ce que j'ai vote, qu'est-ce que j'ai aime »
    match /{path=**}/votes/{voterId} {
      allow read: if true;
    }

    match /{path=**}/reactions/{voterId} {
      allow read: if true;
    }

    // =====================================================================
    // Alliances (amities) et messagerie privee
    // =====================================================================

    match /amities/{pairId} {
      allow read: if signedIn() && uid() in resource.data.paire;
      allow create: if signedIn()
        && uid() in request.resource.data.paire
        && request.resource.data.paire.size() == 2
        && request.resource.data.de == uid()
        && request.resource.data.statut == 'demande';
      // Seule l'autre personne accepte la demande.
      allow update: if signedIn()
        && uid() in resource.data.paire
        && resource.data.de != uid()
        && touchesOnly(['statut', 'majLe'])
        && request.resource.data.statut == 'acceptee';
      allow delete: if (signedIn() && uid() in resource.data.paire) || isAdmin();
    }

    match /dms/{pairId} {
      allow read: if signedIn() && uid() in resource.data.participantUids;
      allow create: if signedIn()
        && uid() in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2;
      allow update: if signedIn() && uid() in resource.data.participantUids;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/dms/$(pairId)).data.participantUids;
        allow create: if signedIn()
          && request.resource.data.uid == uid()
          && str('texte', 4000)
          && uid() in get(/databases/$(database)/documents/dms/$(pairId)).data.participantUids;
        allow update: if false;
        allow delete: if isAdmin() || isOwner(resource.data.uid);
      }
    }

    // =====================================================================
    // Cellules locales (comites par municipalite)
    // =====================================================================

    match /cellules/{celluleId} {
      allow read: if true;
      allow create: if signedIn()
        && str('nom', 120)
        && request.resource.data.fondateurUid == uid();
      allow update: if isAdmin()
        || isOwner(resource.data.fondateurUid)
        || (signedIn() && touchesOnly(['membreUids', 'nbMembres']));
      allow delete: if isAdmin() || isOwner(resource.data.fondateurUid);

      match /demandes/{demandeurId} {
        allow read: if signedIn();
        allow create: if isOwner(demandeurId);
        allow update, delete: if isAdmin()
          || isOwner(demandeurId)
          || isOwner(get(/databases/$(database)/documents/cellules/$(celluleId)).data.fondateurUid);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == uid() && str('texte', 2000);
        allow delete: if isAdmin() || isOwner(resource.data.uid);
      }
    }

    // =====================================================================
    // Actions de mobilisation
    // =====================================================================

    match /actions/{actionId} {
      allow read: if true;
      allow create: if signedIn() && str('title', 200);
      allow update: if isAdmin()
        || isOwner(resource.data.authorId)
        || (signedIn() && touchesOnly(['participantIds', 'participantCount']));
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // =====================================================================
    // Salon de discussion
    // =====================================================================

    match /chat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && str('text', 1000);
      allow update: if false;
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // =====================================================================
    // Evenements
    // =====================================================================

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && str('title', 200);
      allow update: if isAdmin()
        || isOwner(resource.data.auteurUid)
        || (signedIn() && touchesOnly(['rsvpCount']));
      allow delete: if isAdmin() || isOwner(resource.data.auteurUid);

      match /rsvps/{userId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // =====================================================================
    // Questions du public (assemblees et directs)
    // =====================================================================

    match /questions/{questionId} {
      allow read: if true;
      allow create: if str('name', 120)
        && str('question', 1000)
        && request.resource.data.status == 'pending'
        && request.resource.data.upvotes == 0;
      allow update: if isAdmin()
        || (signedIn() && touchesOnly(['upvotes', 'upvoterIds']));
      allow delete: if isAdmin();
    }

    // =====================================================================
    // Photos publiques
    // =====================================================================

    match /photos/{photoId} {
      allow read: if resource.data.statut == 'approuvee'
        || isAdmin()
        || isOwner(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && str('url', 1000)
        && request.resource.data.statut == 'attente';
      allow update: if isAdmin()
        || (isOwner(resource.data.uid) && touchesOnly(['legende', 'majLe']));
      allow delete: if isAdmin() || isOwner(resource.data.uid);
    }

    // =====================================================================
    // Moderation
    // =====================================================================

    match /blocages/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /signalements/{signalementId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.parUid == uid()
        && str('motif', 1000);
      allow update, delete: if isAdmin();
    }

    // =====================================================================
    // Signalement d'un autre projet, ressources, CALME
    // =====================================================================

    match /projectSubmissions/{docId} {
      allow read: if isAdmin();
      allow create: if str('projectName', 200) && str('description', 4000);
      allow update, delete: if isAdmin();
    }

    match /calmPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /resources/{docId} {
      allow read: if true;
      allow create: if signedIn() && str('title', 200);
      allow update, delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // Ancien mur, garde le temps de la migration des donnees.
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && str('text', 5000);
      allow update: if isAdmin() || isOwner(resource.data.authorId);
      allow delete: if isAdmin() || isOwner(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == uid()
          && str('text', 2000);
        allow update, delete: if isAdmin() || isOwner(resource.data.authorId);
      }

      match /reactions/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // =====================================================================
    // Gere par les fonctions uniquement
    // =====================================================================

    match /rateLimits/{doc} {
      allow read, write: if false;
    }

    match /summaryCache/{doc} {
      allow read, write: if false;
    }
  }
}
